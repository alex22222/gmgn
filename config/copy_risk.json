    "max_single_position_percent": 2.0,
    "daily_loss_limit_percent": 5.0,
    "default_slippage_percent": 2.0,
    "max_slippage_percent": 5.0,
    "stop_loss_percent": -40.0,
    "take_profit_steps": [
      {"price_change_percent": 100.0, "sell_percent": 50.0},
      {"price_change_percent": 300.0, "sell_percent": 50.0}
    ]
  },
  "gates": {
    "min_leader_score": 65.0,
    "review_score": 60.0,
    "min_signal_quality": 50,
    "report_lookback_days": 30,
